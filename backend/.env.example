# Copy to backend/.env and adjust. Never commit the real .env file.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Matches the local Postgres container in docker-compose.yml (development-only credentials).
DATABASE_URL=postgresql+psycopg://inbox:inbox_dev_password@127.0.0.1:5432/inbox

# Browser origins allowed to call the API with the session cookie (the Vite web app).
# Use the same host name as the API URL in the web app (both "localhost"), so the
# session cookie counts as same-site.
CORS_ORIGINS=http://localhost:5173

# How long a sign-in lasts (days) before the user must log in again.
SESSION_TTL_DAYS=14

# Send the web session cookie only over HTTPS. Leave unset: it defaults to true when
# ENVIRONMENT=production and false otherwise (local development runs over http).
# COOKIE_SECURE=true
