# Copy to backend/.env and adjust. Never commit the real .env file.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Matches the local Postgres container in docker-compose.yml (development-only credentials).
DATABASE_URL=postgresql+psycopg://inbox:inbox_dev_password@localhost:5432/inbox

# Browser origins allowed to call the API (the Vite web app runs on 5173).
CORS_ORIGINS=http://localhost:5173
