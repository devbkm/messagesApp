# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are embedded in the app bundle,
# so never put secrets here.
#
# Base URL of the backend API. On a physical device or Android emulator, "localhost"
# is the device itself: use your computer's LAN IP (e.g. http://192.168.1.20:8000)
# or http://10.0.2.2:8000 for the Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:8000
