# Copy to apps/web/.env.local. VITE_* values are embedded in the browser bundle,
# so never put secrets here.
#
# Leave empty to call the API on the same origin. In development the Vite server
# proxies /api to the backend (http://127.0.0.1:8000; override with API_PROXY_TARGET),
# which keeps the httpOnly session cookie first-party. Set a full URL only when the
# API is deployed on another origin (and list this site in the API's CORS_ORIGINS).
VITE_API_URL=
